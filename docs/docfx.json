{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/ZDD.Net",
          "files": ["ZDD.Net.csproj"]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["*.md", "toc.yml"]
      },
      {
        "files": ["design/**.md"]
      },
      {
        "files": ["release-notes/**.md", "release-notes/toc.yml"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "ZDD.Net",
      "_appTitle": "ZDD.Net API ドキュメント",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/wix-diesel/ZDD.Net",
        "branch": "main"
      }
    },
    "markdownEngineName": "markdig",
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
